<Window x:Class="PaneCommander.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:PaneCommander.App.Views" Style="{StaticResource {x:Type Window}}" Icon="Assets/PaneCommander.ico" Title="{Binding WindowTitle}" Width="1280" Height="800" MinWidth="850" MinHeight="480" UseLayoutRounding="True" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CaptionBody" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionBody" Property="Background" Value="#406F8090" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CaptionBody" Property="Background" Value="#406F8090" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionBody" Property="Background" Value="#706F8090" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Margin" Value="8" /></DataTrigger></Style.Triggers></Style></DockPanel.Style>
    <Border x:Name="AppTitleBar" DockPanel.Dock="Top" Height="40" Background="{DynamicResource TitleBackgroundBrush}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <DockPanel Margin="10,0,12,0" VerticalAlignment="Center">
          <Image Source="{Binding Icon,RelativeSource={RelativeSource AncestorType=Window}}" Width="16" Height="16" Margin="0,0,8,0" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition>
                <ColumnDefinition.Style>
                  <Style TargetType="ColumnDefinition">
                    <Setter Property="Width" Value="2*" />
                    <Style.Triggers><DataTrigger Binding="{Binding OperationStatus}" Value=""><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers>
                  </Style>
                </ColumnDefinition.Style>
              </ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding WindowTitle}" ToolTip="{Binding WindowTitle}" Foreground="{DynamicResource TitleForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleOperationStatus" Grid.Column="1" Text="{Binding OperationStatus}" ToolTip="{Binding OperationStatus}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TitleForegroundBrush}" Opacity="0.8" WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="TitleMessage_MouseLeftButtonDown">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding OperationStatus}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
        </DockPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,12,0">
          <Button Content="お気に入り" Command="{Binding ToggleFavorites}" ToolTip="サイドバーの表示を切替" />
          <Button Content="更新" Command="{Binding RefreshActive}" ToolTip="Ctrl+R" />
          <Button Content="設定" Command="{Binding OpenSettings}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M0,5 H10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" /></Button>
          <Button x:Name="MaximizeButton" Click="Maximize_Click" AutomationProperties.Name="最大化または元に戻す">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="ToolTip" Value="最大化" /><Style.Triggers><DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="ToolTip" Value="元に戻す" /></DataTrigger></Style.Triggers></Style></Button.Style>
            <Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M0,0 H10 V10 H0 Z" /><Style.Triggers><DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M0,3 H7 V10 H0 Z M3,3 V0 H10 V7 H7" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
          </Button>
          <Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="閉じる" AutomationProperties.Name="閉じる"><Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" /></Button>
        </StackPanel>
      </Grid>
    </Border>
  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
    <DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="描画方式の反映には再起動が必要です" Foreground="#FFC777" VerticalAlignment="Center" Visibility="{Binding RenderingRestartRequired, Converter={StaticResource BoolVisibility}}" />
    </DockPanel>
    <TextBlock Text="{Binding StartupWarning}" TextWrapping="Wrap" Foreground="#FFC777" Margin="5,0">
      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding StartupWarning}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="180" MinWidth="120" MaxWidth="360" />
        <ColumnDefinition x:Name="SidebarSplitterColumn" Width="6" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border x:Name="FavoritesSidebar" AllowDrop="True" DragOver="Favorites_DragOver" Drop="Favorites_Drop" BorderBrush="{DynamicResource InactiveBorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Padding="5">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="＋" Command="{Binding AddFavorite}" ToolTip="現在のフォルダを登録（Ctrl+D）" />
            <TextBlock Text="お気に入り" VerticalAlignment="Center" Margin="3" />
          </DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button Content="名前" Command="{Binding RenameFavorite}" ToolTip="表示名を変更" />
            <Button Content="解除" Command="{Binding RemoveFavorite}" ToolTip="お気に入り登録を解除（フォルダは削除しません）" />
            <Button Content="↑" Command="{Binding MoveFavoriteUp}" ToolTip="上へ" />
            <Button Content="↓" Command="{Binding MoveFavoriteDown}" ToolTip="下へ" />
          </StackPanel>
          <ListBox x:Name="FavoritesList" ItemsSource="{Binding Favorites}" SelectedItem="{Binding SelectedFavorite}" KeyDown="Favorites_KeyDown" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <Button Click="Favorite_Click" Command="{Binding DataContext.OpenFavorite, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Path}" HorizontalContentAlignment="Left" Focusable="False">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </Button>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext" DragCompleted="Sidebar_DragCompleted" Background="{DynamicResource InactiveBorderBrush}" />
    <Grid x:Name="PaneGrid" Grid.Column="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftPaneColumn" MinWidth="280" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition x:Name="RightPaneColumn" MinWidth="280" />
      </Grid.ColumnDefinitions>
      <views:PaneView x:Name="LeftPane" DataContext="{Binding Left}" PreviewMouseDown="Pane_PreviewMouseDown" GotKeyboardFocus="Pane_GotKeyboardFocus" />
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="{DynamicResource InactiveBorderBrush}" ResizeBehavior="PreviousAndNext" />
      <views:PaneView x:Name="RightPane" Grid.Column="2" DataContext="{Binding Right}" PreviewMouseDown="Pane_PreviewMouseDown" GotKeyboardFocus="Pane_GotKeyboardFocus" />
    </Grid>
    </Grid>
    <ItemsControl Grid.Row="2" ItemsSource="{Binding Functions}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Content="{Binding Label}" Command="{Binding Command}" Focusable="False" IsTabStop="False" ToolTip="{Binding Description}" ToolTipService.ShowOnDisabled="True" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
  </DockPanel>
</Window>

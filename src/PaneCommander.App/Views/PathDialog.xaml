<Window x:Class="PaneCommander.App.Views.PathDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}"
        Title="フォルダへ移動" Width="620" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18">
        <TextBlock Text="フォルダの絶対パス" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}" />
        <TextBox x:Name="Editor" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="フォルダの絶対パス" />
        <TextBlock Text="{Binding Error}" Foreground="#E78787" TextWrapping="Wrap" Margin="0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" IsCancel="True" Click="Cancel_Click" />
            <Button Content="OK" IsDefault="True" Click="Ok_Click" MinWidth="75" />
        </StackPanel>
    </StackPanel>
</Window>
